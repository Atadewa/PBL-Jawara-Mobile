# k6 Load Testing Environment Variables
# Copy this file to .env and fill in the values

# Base URL of the API to test
BASE_URL=http://localhost:3000

# Auth token - generate using: node scripts/get-test-token.js
# Token expires after some time, so regenerate when needed
AUTH_TOKEN=your_jwt_token_here

# Optional: Test user credentials (if you need to generate tokens dynamically)
TEST_USER_EMAIL=admin@test.com
TEST_USER_PASSWORD=your_password_here
