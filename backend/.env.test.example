# Environment Variables untuk Testing
# Copy file ini ke .env.test dan isi dengan nilai yang sesuai

# Supabase Configuration
# Gunakan kredensial project Supabase yang sama dengan development
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Server Configuration
PORT=3001
NODE_ENV=test

# Test User Credentials
# Buat test user di Supabase Dashboard → Authentication
# Email: test-admin@testing.local
# Password: test-password-123
# Pastikan user sudah di-confirm dan di-assign role admin
TEST_USER_EMAIL=test-admin@testing.local
TEST_USER_PASSWORD=test-password-123

# Test Admin Token (Optional, untuk integration tests)
# Dapatkan dengan menjalankan: node scripts/get-test-token.js
# Token akan expire, perlu di-refresh periodik
TEST_ADMIN_TOKEN=your-test-token-here

# Tips:
# 1. Buat test user dengan email @testing.local agar mudah dibedakan
# 2. Gunakan password yang kuat tapi mudah diingat untuk testing
# 3. Data test akan menggunakan prefix TEST_ dan akan di-cleanup otomatis
# 4. Lihat SETUP-TEST-USER.md untuk panduan lengkap
